# Copy this file to video/.env and fill in only the services you want to connect.
# video/.env is ignored by git (see video/.gitignore). Never commit a real key and never paste one into chat.
# Check what is connected with:  python video/studio.py doctor

# ElevenLabs voice (narration). Key from https://elevenlabs.io/app/api/api-keys
# The free plan allows non-commercial use with attribution only; paid plans grant commercial rights.
ELEVENLABS_API_KEY=
# The voice to use: a voice id from your ElevenLabs voice library.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Runway AI footage. Sign up at https://dev.runway.com/, create a project, then API Keys.
# The key is shown once. Runway is paid by credits, and credits must be bought before any use.
RUNWAYML_API_SECRET=
